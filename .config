# ---- 目标：小米 AX3000T（U-Boot 布局），变体千万不能选错 ----
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t-ubootmod=y
CONFIG_VERSION_DIST="北冥有鱼定制版"
# ---- LuCI 网页界面 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y

# ---- Argon 主题 + 主题配置 ----
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---- UA3F：UA 改写 ----
CONFIG_PACKAGE_ua3f=y
CONFIG_PACKAGE_sudo=y

# ---- HomeProxy：sing-box 透明代理 ----
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
# ---- 多 WAN / 多拨负载均衡 ----
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_ip-full=y

# ---- 精简项：确认用不到再去掉行首注释 ----
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_luci-proto-ipv6 is not set
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_luci-proto-ppp is not set
